<Window x:Class="SmartHotel.VisualApp.NewRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartHotel.VisualApp"
        mc:Ignorable="d"
        Title="NewRoomWindow" Height="500" Width="400">


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>



        <StackPanel>
            <!-- Número de habitación -->
        <TextBlock Text="Número de Habitación:" Grid.Row="0"  VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="RoomNumberTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

        <!-- Es rentable -->
        <TextBlock Text="¿Es Rentable?" Grid.Row="1"  VerticalAlignment="Center" Margin="0,0,10,10"/>
        <CheckBox x:Name="IsRentableCheckBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Precio -->
        <TextBlock Text="Precio:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="PriceTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>

        <!-- Moneda -->
        <TextBlock Text="Moneda:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <ComboBox x:Name="CurrencyComboBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
            <!--<ComboBoxItem Content="USD"/>
            <ComboBoxItem Content="Euro"/>
            <ComboBoxItem Content="Peso"/>
            <ComboBoxItem Content="MLC"/>-->
        </ComboBox>
        </StackPanel>

        <!--Botones-->
        <StackPanel Grid.Row="2"    Orientation="Horizontal"    HorizontalAlignment="Right">
            <Button Content="Guardar" Margin="5"    Click="Save_Click"/>
            <Button Content="Cancelar" Margin="5"    Click="Cancel_Click"/>
        </StackPanel>
        
        <!--<Button Grid.Row="5" Grid.ColumnSpan="2"
                Content="Guardar"
                Width="120"
                Height="30"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Click="Save_Click"/>-->
    </Grid>
</Window>

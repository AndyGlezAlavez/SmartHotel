<Window x:Class="SmartHotel.VisualApp.AgreementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartHotel.VisualApp"
        mc:Ignorable="d"
        Title="AgreementsWindow" Height="450" Width="700"
        Background="#f4f4f4"    Foreground="#222"   FontFamily="Segoe UI">


    <Grid Margin="20">
        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="39*"/>
            <ColumnDefinition Width="181*"/>
        </Grid.ColumnDefinitions>-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Botones -->
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="RESERVACIONES"
                   Grid.Row="0"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10" />

        <!-- Tabla -->
        <DataGrid x:Name="AgreementsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Margin="0,0,0,10"
                  Background="White"
                  Foreground="#222"
                  BorderBrush="#ccc"
                  BorderThickness="1"
                  RowHeight="32"
                  ColumnHeaderHeight="32"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="AgreementsGrid_MouseDoubleClick" Grid.ColumnSpan="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha Inicio" Binding="{Binding StartDate, StringFormat=d}" Width="*"/>
                <DataGridTextColumn Header="Fecha Fin" Binding="{Binding FinalDate, StringFormat=d}" Width="*"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding ClientName}" Width="*"/>
                <DataGridTextColumn Header="Habitación" Binding="{Binding Room.Number}"  Width="*"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding Room.RentalPrice.Value}" Width="*"/>
                <DataGridTextColumn Header="Moneda" Binding="{Binding Room.RentalPrice.TypeofMoney}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
            <Button Content="Nueva Reserva"  Click="BtnNuevaReserva_Click"  Margin="10,0"/>
            <Button Content="Eliminar Reserva"  Click="BtnDeleteAgreement_Click" Margin="10,0"/>
        </StackPanel>
    </Grid>
</Window>







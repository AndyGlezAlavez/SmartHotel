<Window x:Class="SmartHotel.VisualApp.EditRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartHotel.VisualApp"
        mc:Ignorable="d"
        Title="EditRoomWindow" Height="320" Width="400">
    
    <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>



            <StackPanel>
                <!-- Número de habitación -->
                <TextBlock Text="Número de Habitación:"  VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox x:Name="RoomNumberTextBox"   Margin="0,0,0,10"/>

                <!-- Es rentable -->
                <TextBlock Text="¿Está disponible?"   VerticalAlignment="Center" Margin="0,0,10,10"/>
                <CheckBox x:Name="IsRentableCheckBox"  VerticalAlignment="Center" Margin="0,0,0,10"/>

                <!-- Precio -->
                <TextBlock Text="Precio:"  VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox x:Name="PriceTextBox"  Margin="0,0,0,10"/>

                <!-- Moneda -->
                <TextBlock Text="Moneda:"  VerticalAlignment="Center" Margin="0,0,10,10"/>
                <ComboBox x:Name="CurrencyComboBox"  Margin="0,0,0,10">
                    <!--<ComboBoxItem Content="USD"/>
            <ComboBoxItem Content="Euro"/>
            <ComboBoxItem Content="Peso"/>
            <ComboBoxItem Content="MLC"/>-->
                </ComboBox>
            </StackPanel>

            <!--Botones-->
            <StackPanel Grid.Row="1"    Orientation="Horizontal"    HorizontalAlignment="Right">
                <Button Content="Guardar" Margin="5"    Click="Save_Click"/>
                <Button Content="Cancelar" Margin="5"    Click="Cancel_Click"/>
            </StackPanel>



        </Grid>
</Window>


    
    
    
    
    
    
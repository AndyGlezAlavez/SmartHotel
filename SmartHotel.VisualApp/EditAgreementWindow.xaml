<Window x:Class="SmartHotel.VisualApp.EditAgreementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartHotel.VisualApp"
        mc:Ignorable="d"
        Title="EditAgreementWindow" Height="500" Width="400"
        Background="#f4f4f4"   Foreground="#222"    FontFamily="Segoe UI">


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <StackPanel>
            <TextBlock Text="Fecha de Inicio"   Margin="0,0,0,5"/>
            <DatePicker x:Name="StartDatePicker"
                        Background="White"  Foreground="#222"
                        BorderBrush="#ccc"  BorderThickness="1"/>

            <TextBlock Text="Fecha Fin" Margin="0,10,0,5"/>
            <DatePicker x:Name="FinalDatePicker"
                        Background="White"  Foreground="#222"
                        BorderBrush="#ccc"  BorderThickness="1"/>

            <TextBlock Text="Nombre del cliente"    Margin="0,10,0,5"/>
            <TextBox x:Name="ClientNameTextBox"
                        Background="White"  Foreground="#222"
                        BorderBrush="#ccc"  BorderThickness="1"/>

            <TextBlock Text="Habitación"    Margin="0,10,0,5"/>
            <ComboBox x:Name="RoomComboBox"  DisplayMemberPath="Number" Margin="0,0,0,10"/>

        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right">
            <Button Content="Guardar cambios"  Margin="5" Click="BtnSave_Click"/>
            <Button Content="Cancelar cambios"  Margin="5" Click="BtnCancel_Click"/>
        </StackPanel>

   
    </Grid>

</Window>

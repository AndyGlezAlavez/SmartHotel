<Window x:Class="SmartHotel.VisualApp.EditAgreementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartHotel.VisualApp"
        mc:Ignorable="d"
        Title="EditAgreementWindow" Height="300" Width="400"
        Background="#f4f4f4"   Foreground="#222"    FontFamily="Segoe UI">


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="0"/>
        </Grid.RowDefinitions>


        <StackPanel>
            <TextBlock Text="Fecha de Inicio"   Margin="0,0,0,5" FontSize="12"/>
            <DatePicker x:Name="StartDatePicker"
                        Background="White"  Foreground="#222"
                        BorderBrush="#ccc"  BorderThickness="1"
                         FontSize="16"/>

            <TextBlock Text="Fecha Fin" Margin="0,10,0,5" FontSize="12"/>
            <DatePicker x:Name="FinalDatePicker"
                        Background="White"  Foreground="#222"
                        BorderBrush="#ccc"  BorderThickness="1"
                        FontSize="16"/>

            <TextBlock Text="Nombre del cliente"    Margin="0,10,0,5" FontSize="12"/>
            <TextBox x:Name="ClientTextBox"
                        Background="White"  Foreground="#222"
                        BorderBrush="#ccc"  BorderThickness="1"
                        Padding="4" TextChanged="ClientTextBox_TextChanged" FontSize="16"/>
        </StackPanel>

        <Button Content="Guardar cambios"
                Grid.Row="1"
                Margin="0,15,0,0"
                HorizontalAlignment="Right"
                FontWeight="SemiBold"
                Background="#e0e0e0"
                Foreground="#222"
                BorderBrush="#bbb" 
                BorderThickness="1"
                Cursor="Hand"
                Click="btnSave_Click"/>
    </Grid>

</Window>

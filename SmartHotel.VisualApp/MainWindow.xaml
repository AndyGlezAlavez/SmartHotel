<Window x:Class="SmartHotel.VisualApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartHotel.VisualApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="600">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título centrado -->
        <TextBlock Text="RESERVACIONES" FontSize="28" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,10"/>

        <!-- Lista de reservaciones -->
        <DataGrid x:Name="AgreementsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  Margin="0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha Inicio"   Binding="{Binding StartDate}" Width="*"/>
                <DataGridTextColumn Header="Fecha Fin"   Binding="{Binding FinalDate}" Width="*"/>
                <DataGridTextColumn Header="Cliente"   Binding="{Binding ClientName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Botones -->
            <StackPanel Orientation="Horizontal"
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        Margin ="0, 10, 0, 0">

                <Button Content="Nueva Reserva" Margin="5"/>
            <Button Content="Eliminar Reserva" Margin="5"/>
        </StackPanel>
            
       
    </Grid>
</Window>




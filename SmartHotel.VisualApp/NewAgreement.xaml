<Window x:Class="SmartHotel.VisualApp.NewAgreement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartHotel.VisualApp"
        mc:Ignorable="d"
        Title="NewAgreement" Height="350" Width="400"
        Background="#f4f4f4"    Foreground="#222"   FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <StackPanel>
            <TextBlock Text="Fecha de Inicio"   Margin="0,0,0,5"/>
            <DatePicker x:Name="StartDatePicker"
                        Background="White"
                        Foreground="#222"
                        BorderBrush="#ccc"  BorderThickness="1"/>

            <TextBlock Text="Fecha de Fin"  Margin="0,10,0,5"/>
            <DatePicker x:Name="FinalDatePicker"
                        Background="White"
                        Foreground="#222"
                        BorderBrush="#ccc"  BorderThickness="1"/>

            <TextBlock Text="Nombre del cliente"   Margin="0,10,0,5" />
            <TextBox x:Name="ClientNameTextBox"
                        Background="White"
                        Foreground="#222"
                        BorderBrush="#ccc"  BorderThickness="1"/>

            <TextBlock Text="Habitación"   Margin="0,10,0,5" />
            <ComboBox x:Name="RoomComboBox" DisplayMemberPath="Number"/>


        </StackPanel>

        <StackPanel Grid.Row="2"    Orientation="Horizontal"    HorizontalAlignment="Right">
            <Button Content="Guardar" Margin="5"    Click="Save_Click"/>
            <Button Content="Cancelar" Margin="5"    Click="Cancel_Click"/>


        </StackPanel>
        <!--<Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>-->
        

           
    </Grid>
</Window>
